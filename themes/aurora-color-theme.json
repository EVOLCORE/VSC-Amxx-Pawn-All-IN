{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Aurora",
  "type": "dark",
  "colors": {
    "editor.background": "#14212B",
    "editor.foreground": "#E8F3F7",
    "editorLineNumber.foreground": "#607986",
    "editorLineNumber.activeForeground": "#A5C0CB",
    "editorCursor.foreground": "#F3FBFF",
    "editor.selectionBackground": "#203540",
    "editor.inactiveSelectionBackground": "#1A2F39",
    "editor.lineHighlightBackground": "#182A34",
    "editorIndentGuide.background1": "#29424F",
    "editorIndentGuide.activeBackground1": "#426674",
    "editorWhitespace.foreground": "#2A424E",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#FF5B98",
    "sideBar.background": "#101A21",
    "activityBar.background": "#101A21",
    "titleBar.activeBackground": "#101A21",
    "statusBar.background": "#101A21",
    "statusBar.foreground": "#E8F3F7",
    "statusBar.border": "#101A21",
    "statusBar.noFolderBackground": "#101A21",
    "statusBar.debuggingBackground": "#1B2A33",
    "editorHoverWidget.background": "#12202A",
    "editorHoverWidget.border": "#315A6C",
    "editorHoverWidget.foreground": "#E8F3F7"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "number": "#BF93FF"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block.pawn", "comment.block.documentation.pawn", "comment.line.double-slash.pawn"], "settings": { "foreground": "#7993A0", "fontStyle": "italic" } },
    { "scope": ["comment.keyword.todo.pawn"], "settings": { "foreground": "#FF7AAA", "fontStyle": "bold italic" } },
    { "scope": ["comment.annotation.tag.pawn", "comment.annotation.parameter.pawn"], "settings": { "foreground": "#92B5C2", "fontStyle": "italic" } },
    { "scope": ["comment.string.quoted.double.pawn", "comment.string.quoted.single.pawn"], "settings": { "foreground": "#9CA98E", "fontStyle": "italic" } },
    { "scope": ["comment.constant.numeric.pawn"], "settings": { "foreground": "#A99ACA", "fontStyle": "italic" } },
    { "scope": ["keyword.other.preprocessor.pawn", "keyword.other.preprocessor.include.pawn", "keyword.other.preprocessor.define.pawn", "punctuation.definition.directive.pawn", "keyword.control.directive.pawn", "keyword.control.directive.include.pawn", "keyword.control.directive.define.pawn"], "settings": { "foreground": "#7AD7F0" } },
    { "scope": ["string.quoted.other.include.pawn", "entity.name.filename.include.pawn", "include_path.pawn"], "settings": { "foreground": "#9FD7FF" } },
    { "scope": ["constant.other.preprocessor.pawn", "entity.name.constant.preprocessor"], "settings": { "foreground": "#72E0FF" } },
    { "scope": ["storage.type.function.pawn", "storage.modifier.tag.pawn"], "settings": { "foreground": "#85E7FF", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.definition.pawn", "support.function.definition.pawn"], "settings": { "foreground": "#C1F55A", "fontStyle": "bold" } },
    { "scope": ["entity.name.function.preprocessor.pawn", "entity.name.function.call.pawn", "support.function.call.pawn", "entity.name.function.call.amxxpawn", "entity.name.function.call", "support.function"], "settings": { "foreground": "#56D5FF" } },
    { "scope": ["meta.signature.argument.active.pawn", "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#A6E22E", "fontStyle": "bold" } },
    { "scope": ["meta.signature.argument.error.pawn", "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#FF5370", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.invisible.amxxpawn"], "settings": { "foreground": "#14212B" } },
    { "scope": ["storage.type.vars.pawn", "keyword.control.pawn"], "settings": { "foreground": "#FF5B98" } },
    { "scope": ["storage.type.enum.pawn", "constant.other.case-label.pawn"], "settings": { "foreground": "#72E0FF", "fontStyle": "italic" } },
    { "scope": ["constant.other.enum.member.pawn"], "settings": { "foreground": "#DCEAF0" } },
    { "scope": ["constant.language", "constant.numeric", "constant.numeric.integer.pawn", "constant.numeric.int.pawn", "constant.numeric.float.pawn", "constant.numeric.hex.pawn", "constant.numeric.symbol.pawn", "constant.numeric.preprocessor.pawn"], "settings": { "foreground": "#BF93FF" } },
    { "scope": ["string", "string.quoted.double.pawn", "string.quoted.single.pawn"], "settings": { "foreground": "#FFD47B" } },
    { "scope": ["constant.other.placeholder.pawn"], "settings": { "foreground": "#BF93FF", "fontStyle": "bold" } },
    { "scope": ["constant.character.escape.pawn"], "settings": { "foreground": "#C1F55A" } },
    { "scope": ["variable.other.pawn", "variable.other.preprocessor.pawn"], "settings": { "foreground": "#E8F3F7" } },
    { "scope": ["punctuation.separator.comma.pawn", "punctuation.terminator.statement.pawn", "punctuation.section.block.pawn", "punctuation.section.brackets.pawn", "punctuation.section.parens.pawn", "punctuation.section.parameters.begin.pawn", "punctuation.section.parameters.end.pawn", "punctuation.section.arguments.begin.pawn", "keyword.coma.pawn", "keyword.brace.pawn", "keyword.brackets.pawn", "parens.pawn", "function.parens.begin.pawn", "function.parens.end.pawn"], "settings": { "foreground": "#FF5B98" } },
    { "scope": ["keyword.operator.assignment.pawn", "keyword.operator.comparison.pawn", "keyword.operator.increment-decrement.pawn", "keyword.operator.ternary.pawn", "keyword.operator.logical.pawn", "keyword.operator.bitwise.pawn", "keyword.operator.arithmetic.pawn"], "settings": { "foreground": "#FF5B98" } },
    { "scope": ["invalid.illegal", "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn", "invalid.illegal.stray-comment-end.pawn", "invalid.illegal.invalid-character.pawn", "invalid.illegal.unknown-escape.pawn"], "settings": { "foreground": "#111111", "background": "#FF5370" } }
  ]
}
