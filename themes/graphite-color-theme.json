{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Graphite",
  "type": "dark",
  "colors": {
    "editor.background": "#20242B",
    "editor.foreground": "#D9E0E8",
    "editorLineNumber.foreground": "#65707C",
    "editorLineNumber.activeForeground": "#AAB4BF",
    "editorCursor.foreground": "#F0F4F8",
    "editor.selectionBackground": "#333B46",
    "editor.inactiveSelectionBackground": "#2B323C",
    "editor.lineHighlightBackground": "#272D36",
    "editorIndentGuide.background1": "#343C47",
    "editorIndentGuide.activeBackground1": "#596473",
    "editorWhitespace.foreground": "#333A45",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#F14C88",
    "sideBar.background": "#1B1F25",
    "activityBar.background": "#1B1F25",
    "titleBar.activeBackground": "#1B1F25",
    "statusBar.background": "#1B1F25",
    "statusBar.foreground": "#D9E0E8",
    "statusBar.border": "#1B1F25",
    "statusBar.noFolderBackground": "#1B1F25",
    "statusBar.debuggingBackground": "#252B34",
    "editorHoverWidget.background": "#1D2229",
    "editorHoverWidget.border": "#404A57",
    "editorHoverWidget.foreground": "#D9E0E8"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block.pawn", "comment.line.double-slash.pawn"], "settings": { "foreground": "#7C8793", "fontStyle": "italic" } },
    { "scope": ["keyword.other.preprocessor.pawn", "keyword.other.preprocessor.include.pawn", "keyword.other.preprocessor.define.pawn"], "settings": { "foreground": "#D9E0E8" } },
    { "scope": ["include_path.pawn"], "settings": { "foreground": "#D9E0E8" } },
    { "scope": ["entity.name.constant.preprocessor"], "settings": { "foreground": "#72CFEF" } },
    { "scope": ["storage.type.function.pawn", "storage.modifier.tag.pawn"], "settings": { "foreground": "#88DBFF", "fontStyle": "italic" } },
    { "scope": ["support.function.definition.pawn"], "settings": { "foreground": "#B7E35B", "fontStyle": "bold" } },
    { "scope": ["support.function.call.pawn", "entity.name.function.call.amxxpawn", "entity.name.function.call", "support.function"], "settings": { "foreground": "#61D0F2" } },
    { "scope": ["meta.signature.argument.active.pawn", "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#A6E22E", "fontStyle": "bold" } },
    { "scope": ["meta.signature.argument.error.pawn", "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#FF5370", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.invisible.amxxpawn"], "settings": { "foreground": "#20242B" } },
    { "scope": ["storage.type.vars.pawn", "keyword.control.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["storage.type.enum.pawn", "constant.other.case-label.pawn"], "settings": { "foreground": "#72CFEF", "fontStyle": "italic" } },
    { "scope": ["constant.language", "constant.numeric.int.pawn", "constant.numeric.float.pawn", "constant.numeric.hex.pawn"], "settings": { "foreground": "#B78CFF" } },
    { "scope": ["string", "string.quoted.double.pawn", "string.quoted.single.pawn"], "settings": { "foreground": "#E5C07B" } },
    { "scope": ["constant.other.placeholder.pawn"], "settings": { "foreground": "#B78CFF", "fontStyle": "bold" } },
    { "scope": ["constant.character.escape.pawn"], "settings": { "foreground": "#B7E35B" } },
    { "scope": ["variable.other.pawn", "constant.vars.pawn"], "settings": { "foreground": "#D9E0E8" } },
    { "scope": ["keyword.coma.pawn", "keyword.brace.pawn", "keyword.brackets.pawn", "parens.pawn", "function.parens.begin.pawn", "function.parens.end.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["keyword.operator.assignment.pawn", "keyword.operator.comparison.pawn", "keyword.operator.increment-decrement.pawn", "keyword.operator.ternary.pawn", "keyword.operator.logical.pawn", "keyword.operator.bitwise.pawn", "keyword.operator.arithmetic.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["invalid.illegal", "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn", "invalid.illegal.stray-comment-end.pawn", "invalid.illegal.invalid-character.pawn", "invalid.illegal.unknown-escape.pawn"], "settings": { "foreground": "#111111", "background": "#FF5370" } }
  ]
}
