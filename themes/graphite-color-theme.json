{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Graphite",
  "type": "dark",
  "colors": {
    "editor.background": "#20242B",
    "editor.foreground": "#D9E0E8",
    "editorLineNumber.foreground": "#65707C",
    "editorLineNumber.activeForeground": "#AAB4BF",
    "editorCursor.foreground": "#F0F4F8",
    "editor.selectionBackground": "#333B46",
    "editor.inactiveSelectionBackground": "#2B323C",
    "editor.lineHighlightBackground": "#272D36",
    "editorIndentGuide.background1": "#343C47",
    "editorIndentGuide.activeBackground1": "#596473",
    "editorWhitespace.foreground": "#333A45",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#F14C88",
    "sideBar.background": "#1B1F25",
    "activityBar.background": "#1B1F25",
    "titleBar.activeBackground": "#1B1F25",
    "statusBar.background": "#1B1F25",
    "statusBar.foreground": "#D9E0E8",
    "statusBar.border": "#1B1F25",
    "statusBar.noFolderBackground": "#1B1F25",
    "statusBar.debuggingBackground": "#252B34",
    "editorHoverWidget.background": "#1D2229",
    "editorHoverWidget.border": "#404A57",
    "editorHoverWidget.foreground": "#D9E0E8"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "number": "#B78CFF",
    "function": "#61D0F2",
    "function.declaration": {
      "foreground": "#B7E35B",
      "fontStyle": "bold"
    }
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block.pawn", "comment.block.documentation.pawn", "comment.line.double-slash.pawn"], "settings": { "foreground": "#7C8793", "fontStyle": "italic" } },
    { "scope": ["comment.keyword.todo.pawn"], "settings": { "foreground": "#F076A2", "fontStyle": "bold italic" } },
    { "scope": ["comment.annotation.tag.pawn", "comment.annotation.parameter.pawn"], "settings": { "foreground": "#8FA7B5", "fontStyle": "italic" } },
    { "scope": ["comment.string.quoted.double.pawn", "comment.string.quoted.single.pawn"], "settings": { "foreground": "#9DA48C", "fontStyle": "italic" } },
    { "scope": ["comment.constant.numeric.pawn"], "settings": { "foreground": "#A397C0", "fontStyle": "italic" } },
    { "scope": ["keyword.other.preprocessor.pawn", "keyword.other.preprocessor.include.pawn", "keyword.other.preprocessor.define.pawn", "punctuation.definition.directive.pawn", "keyword.control.directive.pawn", "keyword.control.directive.include.pawn", "keyword.control.directive.define.pawn"], "settings": { "foreground": "#74B8FF" } },
    { "scope": ["string.quoted.other.include.pawn", "entity.name.filename.include.pawn", "include_path.pawn"], "settings": { "foreground": "#A9C9EF" } },
    { "scope": ["constant.other.preprocessor.pawn", "entity.name.constant.preprocessor"], "settings": { "foreground": "#72CFEF" } },
    { "scope": ["storage.type.function.pawn", "storage.modifier.tag.pawn"], "settings": { "foreground": "#88DBFF", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.definition.pawn", "support.function.definition.pawn"], "settings": { "foreground": "#B7E35B", "fontStyle": "bold" } },
    { "scope": ["entity.name.function.preprocessor.pawn", "entity.name.function.call.pawn", "support.function.call.pawn", "entity.name.function.call.amxxpawn", "entity.name.function.call", "support.function"], "settings": { "foreground": "#61D0F2" } },
    { "scope": ["meta.signature.argument.active.pawn", "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#A6E22E", "fontStyle": "bold" } },
    { "scope": ["meta.signature.argument.error.pawn", "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#FF5370", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.invisible.amxxpawn"], "settings": { "foreground": "#20242B" } },
    { "scope": ["storage.type.vars.pawn", "keyword.control.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["storage.type.enum.pawn", "constant.other.case-label.pawn"], "settings": { "foreground": "#72CFEF", "fontStyle": "italic" } },
    { "scope": ["constant.other.enum.member.pawn"], "settings": { "foreground": "#CED7E1" } },
    { "scope": ["constant.language", "constant.numeric", "constant.numeric.integer.pawn", "constant.numeric.int.pawn", "constant.numeric.float.pawn", "constant.numeric.hex.pawn", "constant.numeric.symbol.pawn", "constant.numeric.preprocessor.pawn"], "settings": { "foreground": "#B78CFF" } },
    { "scope": ["string", "string.quoted.double.pawn", "string.quoted.single.pawn"], "settings": { "foreground": "#E5C07B" } },
    { "scope": ["constant.other.placeholder.pawn"], "settings": { "foreground": "#B78CFF", "fontStyle": "bold" } },
    { "scope": ["constant.character.escape.pawn"], "settings": { "foreground": "#B7E35B" } },
    { "scope": ["variable.other.pawn", "variable.other.preprocessor.pawn"], "settings": { "foreground": "#D9E0E8" } },
    { "scope": ["punctuation.separator.comma.pawn", "punctuation.terminator.statement.pawn", "punctuation.section.block.pawn", "punctuation.section.brackets.pawn", "punctuation.section.parens.pawn", "punctuation.section.parameters.begin.pawn", "punctuation.section.parameters.end.pawn", "punctuation.section.arguments.begin.pawn", "keyword.coma.pawn", "keyword.brace.pawn", "keyword.brackets.pawn", "parens.pawn", "function.parens.begin.pawn", "function.parens.end.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["keyword.operator.assignment.pawn", "keyword.operator.comparison.pawn", "keyword.operator.increment-decrement.pawn", "keyword.operator.ternary.pawn", "keyword.operator.logical.pawn", "keyword.operator.bitwise.pawn", "keyword.operator.arithmetic.pawn"], "settings": { "foreground": "#F14C88" } },
    { "scope": ["invalid.illegal", "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn", "invalid.illegal.stray-comment-end.pawn", "invalid.illegal.invalid-character.pawn", "invalid.illegal.unknown-escape.pawn"], "settings": { "foreground": "#111111", "background": "#FF5370" } }
  ]
}
