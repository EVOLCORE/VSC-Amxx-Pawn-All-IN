{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1F232A",
    "editor.foreground": "#E6EDF3",
    "editorLineNumber.foreground": "#59636E",
    "editorLineNumber.activeForeground": "#A6B1BC",
    "editorCursor.foreground": "#F0F6FC",
    "editor.selectionBackground": "#2F3742",
    "editor.inactiveSelectionBackground": "#28303A",
    "editor.lineHighlightBackground": "#242A33",
    "editorIndentGuide.background1": "#313843",
    "editorIndentGuide.activeBackground1": "#586170",
    "editorWhitespace.foreground": "#313742",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#FF4D8D",
    "sideBar.background": "#1A1E24",
    "activityBar.background": "#1A1E24",
    "titleBar.activeBackground": "#1A1E24",
    "statusBar.background": "#1A1E24",
    "statusBar.foreground": "#E6EDF3",
    "statusBar.border": "#1A1E24",
    "statusBar.noFolderBackground": "#1A1E24",
    "statusBar.debuggingBackground": "#242A33",
    "editorHoverWidget.background": "#1C2128",
    "editorHoverWidget.border": "#3A4552",
    "editorHoverWidget.foreground": "#E6EDF3"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block.pawn", "comment.line.double-slash.pawn"], "settings": { "foreground": "#7A828E", "fontStyle": "italic" } },
    { "scope": ["keyword.other.preprocessor.pawn", "keyword.other.preprocessor.include.pawn", "keyword.other.preprocessor.define.pawn"], "settings": { "foreground": "#E6EDF3" } },
    { "scope": ["include_path.pawn"], "settings": { "foreground": "#E6EDF3" } },
    { "scope": ["entity.name.constant.preprocessor"], "settings": { "foreground": "#79C0FF" } },
    { "scope": ["storage.type.function.pawn", "storage.modifier.tag.pawn"], "settings": { "foreground": "#8BDAFF", "fontStyle": "italic" } },
    { "scope": ["support.function.definition.pawn"], "settings": { "foreground": "#B9E769", "fontStyle": "bold" } },
    { "scope": ["support.function.call.pawn", "entity.name.function.call.amxxpawn", "entity.name.function.call", "support.function"], "settings": { "foreground": "#67D4FF" } },
    { "scope": ["meta.signature.argument.active.pawn", "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#A6E22E", "fontStyle": "bold" } },
    { "scope": ["meta.signature.argument.error.pawn", "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#FF5370", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.invisible.amxxpawn"], "settings": { "foreground": "#1F232A" } },
    { "scope": ["storage.type.vars.pawn", "keyword.control.pawn"], "settings": { "foreground": "#FF4D8D" } },
    { "scope": ["storage.type.enum.pawn", "constant.other.case-label.pawn"], "settings": { "foreground": "#79C0FF", "fontStyle": "italic" } },
    { "scope": ["constant.language", "constant.numeric.int.pawn", "constant.numeric.float.pawn", "constant.numeric.hex.pawn"], "settings": { "foreground": "#C297FF" } },
    { "scope": ["string", "string.quoted.double.pawn", "string.quoted.single.pawn"], "settings": { "foreground": "#EBCB8B" } },
    { "scope": ["constant.other.placeholder.pawn"], "settings": { "foreground": "#C297FF", "fontStyle": "bold" } },
    { "scope": ["constant.character.escape.pawn"], "settings": { "foreground": "#B9E769" } },
    { "scope": ["variable.other.pawn", "constant.vars.pawn"], "settings": { "foreground": "#E6EDF3" } },
    { "scope": ["keyword.coma.pawn", "keyword.brace.pawn", "keyword.brackets.pawn", "parens.pawn", "function.parens.begin.pawn", "function.parens.end.pawn"], "settings": { "foreground": "#FF4D8D" } },
    { "scope": ["keyword.operator.assignment.pawn", "keyword.operator.comparison.pawn", "keyword.operator.increment-decrement.pawn", "keyword.operator.ternary.pawn", "keyword.operator.logical.pawn", "keyword.operator.bitwise.pawn", "keyword.operator.arithmetic.pawn"], "settings": { "foreground": "#FF4D8D" } },
    { "scope": ["invalid.illegal", "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn", "invalid.illegal.stray-comment-end.pawn", "invalid.illegal.invalid-character.pawn", "invalid.illegal.unknown-escape.pawn"], "settings": { "foreground": "#111111", "background": "#FF5370" } }
  ]
}
