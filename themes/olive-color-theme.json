{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Olive",
  "type": "dark",
  "colors": {
    "editor.background": "#282922",
    "editor.foreground": "#F2F2E8",
    "editorLineNumber.foreground": "#595B50",
    "editorLineNumber.activeForeground": "#A9AC9A",
    "editorCursor.foreground": "#F3F2D5",
    "editor.selectionBackground": "#3A3D32",
    "editor.inactiveSelectionBackground": "#33362C",
    "editor.lineHighlightBackground": "#2D2F27",
    "editorIndentGuide.background1": "#3A3C33",
    "editorIndentGuide.activeBackground1": "#595D50",
    "editorWhitespace.foreground": "#3B3D34",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#FF1F86",
    "sideBar.background": "#23241F",
    "activityBar.background": "#23241F",
    "titleBar.activeBackground": "#23241F",
    "statusBar.background": "#23241F",
    "statusBar.foreground": "#F2F2E8",
    "statusBar.border": "#23241F",
    "statusBar.noFolderBackground": "#23241F",
    "statusBar.debuggingBackground": "#2C2D27",
    "editorHoverWidget.background": "#23241F",
    "editorHoverWidget.border": "#45483B",
    "editorHoverWidget.foreground": "#F2F2E8"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "number": "#AE81FF",
    "function": "#66D9EF",
    "function.declaration": {
      "foreground": "#C6E64A",
      "fontStyle": "bold"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.block.pawn",
        "comment.block.documentation.pawn",
        "comment.line.double-slash.pawn"
      ],
      "settings": {
        "foreground": "#6E705F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.keyword.todo.pawn"
      ],
      "settings": {
        "foreground": "#FF6DA7",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "comment.annotation.tag.pawn",
        "comment.annotation.parameter.pawn"
      ],
      "settings": {
        "foreground": "#8A9F9B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.string.quoted.double.pawn",
        "comment.string.quoted.single.pawn"
      ],
      "settings": {
        "foreground": "#8E9670",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.constant.numeric.pawn"
      ],
      "settings": {
        "foreground": "#9382AA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.other.preprocessor.pawn",
        "keyword.other.preprocessor.include.pawn",
        "keyword.other.preprocessor.define.pawn",
        "punctuation.definition.directive.pawn",
        "keyword.control.directive.pawn",
        "keyword.control.directive.include.pawn",
        "keyword.control.directive.define.pawn"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "scope": [
        "string.quoted.other.include.pawn",
        "entity.name.filename.include.pawn",
        "include_path.pawn"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "scope": [
        "constant.other.preprocessor.pawn",
        "entity.name.constant.preprocessor"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "scope": [
        "storage.type.function.pawn",
        "storage.modifier.tag.pawn"
      ],
      "settings": {
        "foreground": "#8BE9FD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function.definition.pawn",
        "support.function.definition.pawn"
      ],
      "settings": {
        "foreground": "#C6E64A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.preprocessor.pawn",
        "entity.name.function.call.pawn",
        "support.function.call.pawn",
        "entity.name.function.call.amxxpawn",
        "entity.name.function.call",
        "support.function"
      ],
      "settings": {
        "foreground": "#66D9EF"
      }
    },
    {
      "scope": [
        "meta.signature.argument.active.pawn"
      ],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.signature.argument.error.pawn"
      ],
      "settings": {
        "foreground": "#FF5370",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"
      ],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"
      ],
      "settings": {
        "foreground": "#FF5370",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.definition.invisible.amxxpawn"
      ],
      "settings": {
        "foreground": "#282922"
      }
    },
    {
      "scope": [
        "storage.type.vars.pawn",
        "keyword.control.pawn"
      ],
      "settings": {
        "foreground": "#FF1F86"
      }
    },
    {
      "scope": [
        "storage.type.enum.pawn"
      ],
      "settings": {
        "foreground": "#66D9EF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.other.case-label.pawn"
      ],
      "settings": {
        "foreground": "#66D9EF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.other.enum.member.pawn"
      ],
      "settings": {
        "foreground": "#E7E7D6"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.numeric",
        "constant.numeric.integer.pawn",
        "constant.numeric.int.pawn",
        "constant.numeric.float.pawn",
        "constant.numeric.hex.pawn",
        "constant.numeric.symbol.pawn",
        "constant.numeric.preprocessor.pawn"
      ],
      "settings": {
        "foreground": "#AE81FF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.double.pawn",
        "string.quoted.single.pawn"
      ],
      "settings": {
        "foreground": "#E6DB74"
      }
    },
    {
      "scope": [
        "constant.other.placeholder.pawn"
      ],
      "settings": {
        "foreground": "#AE81FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.character.escape.pawn"
      ],
      "settings": {
        "foreground": "#A6E22E"
      }
    },
    {
      "scope": [
        "variable.other.pawn",
        "variable.other.preprocessor.pawn"
      ],
      "settings": {
        "foreground": "#F2F2E8"
      }
    },
    {
      "scope": [
        "punctuation.separator.comma.pawn",
        "punctuation.terminator.statement.pawn",
        "punctuation.section.block.pawn",
        "punctuation.section.brackets.pawn",
        "punctuation.section.parens.pawn",
        "punctuation.section.parameters.begin.pawn",
        "punctuation.section.parameters.end.pawn",
        "punctuation.section.arguments.begin.pawn",
        "keyword.coma.pawn",
        "keyword.brace.pawn",
        "keyword.brackets.pawn",
        "parens.pawn",
        "function.parens.begin.pawn",
        "function.parens.end.pawn"
      ],
      "settings": {
        "foreground": "#FF1F86"
      }
    },
    {
      "scope": [
        "keyword.operator.assignment.pawn",
        "keyword.operator.comparison.pawn",
        "keyword.operator.increment-decrement.pawn",
        "keyword.operator.ternary.pawn",
        "keyword.operator.logical.pawn",
        "keyword.operator.bitwise.pawn",
        "keyword.operator.arithmetic.pawn"
      ],
      "settings": {
        "foreground": "#FF1F86"
      }
    },
    {
      "scope": [
        "invalid.illegal",
        "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn",
        "invalid.illegal.stray-comment-end.pawn",
        "invalid.illegal.invalid-character.pawn",
        "invalid.illegal.unknown-escape.pawn"
      ],
      "settings": {
        "foreground": "#111111",
        "background": "#FF5370"
      }
    }
  ]
}
