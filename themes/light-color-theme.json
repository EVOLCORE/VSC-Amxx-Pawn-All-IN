{
  "$schema": "vscode://schemas/color-theme",
  "name": "AmxxPawnAllIn Light",
  "type": "light",
  "colors": {
    "editor.background": "#F7F5EF",
    "editor.foreground": "#2B2F36",
    "editorLineNumber.foreground": "#9C968B",
    "editorLineNumber.activeForeground": "#58554E",
    "editorCursor.foreground": "#2B2F36",
    "editor.selectionBackground": "#DDE7F2",
    "editor.inactiveSelectionBackground": "#E8EEF5",
    "editor.lineHighlightBackground": "#F0ECE4",
    "editorIndentGuide.background1": "#DDD7CD",
    "editorIndentGuide.activeBackground1": "#B8AFA1",
    "editorWhitespace.foreground": "#D8D2C8",
    "editorBracketMatch.background": "#00000000",
    "editorBracketMatch.border": "#D63A71",
    "sideBar.background": "#EFEAE0",
    "activityBar.background": "#EFEAE0",
    "titleBar.activeBackground": "#EFEAE0",
    "statusBar.background": "#EFEAE0",
    "statusBar.foreground": "#2B2F36",
    "statusBar.border": "#E0D8CC",
    "statusBar.noFolderBackground": "#EFEAE0",
    "statusBar.debuggingBackground": "#E7DECF",
    "editorHoverWidget.background": "#FBFAF6",
    "editorHoverWidget.border": "#D6CCBC",
    "editorHoverWidget.foreground": "#2B2F36"
  },
  "tokenColors": [
    { "scope": ["comment", "comment.block.pawn", "comment.block.documentation.pawn", "comment.line.double-slash.pawn"], "settings": { "foreground": "#8C8579", "fontStyle": "italic" } },
    { "scope": ["comment.keyword.todo.pawn"], "settings": { "foreground": "#C94E76", "fontStyle": "bold italic" } },
    { "scope": ["comment.annotation.tag.pawn", "comment.annotation.parameter.pawn"], "settings": { "foreground": "#527F91", "fontStyle": "italic" } },
    { "scope": ["comment.string.quoted.double.pawn", "comment.string.quoted.single.pawn"], "settings": { "foreground": "#7F7A58", "fontStyle": "italic" } },
    { "scope": ["comment.constant.numeric.pawn"], "settings": { "foreground": "#77689A", "fontStyle": "italic" } },
    { "scope": ["keyword.other.preprocessor.pawn", "keyword.other.preprocessor.include.pawn", "keyword.other.preprocessor.define.pawn"], "settings": { "foreground": "#2B2F36" } },
    { "scope": ["string.quoted.other.include.pawn", "include_path.pawn"], "settings": { "foreground": "#2B2F36" } },
    { "scope": ["constant.other.preprocessor.pawn", "entity.name.constant.preprocessor"], "settings": { "foreground": "#0E88B8" } },
    { "scope": ["storage.type.function.pawn", "storage.modifier.tag.pawn"], "settings": { "foreground": "#198BBE", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.definition.pawn", "support.function.definition.pawn"], "settings": { "foreground": "#7EA80E", "fontStyle": "bold" } },
    { "scope": ["entity.name.function.preprocessor.pawn", "entity.name.function.call.pawn", "support.function.call.pawn", "entity.name.function.call.amxxpawn", "entity.name.function.call", "support.function"], "settings": { "foreground": "#117DAA" } },
    { "scope": ["meta.signature.argument.active.pawn", "meta.signature.argument.active.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#5E9F00", "fontStyle": "bold" } },
    { "scope": ["meta.signature.argument.error.pawn", "meta.signature.argument.error.pawn keyword.operator.bitwise.pawn"], "settings": { "foreground": "#D43D51", "fontStyle": "bold" } },
    { "scope": ["punctuation.definition.invisible.amxxpawn"], "settings": { "foreground": "#F7F5EF" } },
    { "scope": ["storage.type.vars.pawn", "keyword.control.pawn"], "settings": { "foreground": "#D63A71" } },
    { "scope": ["storage.type.enum.pawn", "constant.other.case-label.pawn"], "settings": { "foreground": "#0E88B8", "fontStyle": "italic" } },
    { "scope": ["constant.other.enum.member.pawn"], "settings": { "foreground": "#3A3F46" } },
    { "scope": ["constant.language", "constant.numeric", "constant.numeric.integer.pawn", "constant.numeric.int.pawn", "constant.numeric.float.pawn", "constant.numeric.hex.pawn", "constant.numeric.symbol.pawn", "constant.numeric.preprocessor.pawn"], "settings": { "foreground": "#8F5CD6" } },
    { "scope": ["string", "string.quoted.double.pawn", "string.quoted.single.pawn"], "settings": { "foreground": "#B07A00" } },
    { "scope": ["constant.other.placeholder.pawn"], "settings": { "foreground": "#8F5CD6", "fontStyle": "bold" } },
    { "scope": ["constant.character.escape.pawn"], "settings": { "foreground": "#6F9800" } },
    { "scope": ["variable.other.pawn"], "settings": { "foreground": "#2B2F36" } },
    { "scope": ["punctuation.separator.comma.pawn", "punctuation.terminator.statement.pawn", "punctuation.section.block.pawn", "punctuation.section.brackets.pawn", "punctuation.section.parens.pawn", "punctuation.section.parameters.begin.pawn", "punctuation.section.parameters.end.pawn", "punctuation.section.arguments.begin.pawn", "keyword.coma.pawn", "keyword.brace.pawn", "keyword.brackets.pawn", "parens.pawn", "function.parens.begin.pawn", "function.parens.end.pawn"], "settings": { "foreground": "#D63A71" } },
    { "scope": ["keyword.operator.assignment.pawn", "keyword.operator.comparison.pawn", "keyword.operator.increment-decrement.pawn", "keyword.operator.ternary.pawn", "keyword.operator.logical.pawn", "keyword.operator.bitwise.pawn", "keyword.operator.arithmetic.pawn"], "settings": { "foreground": "#D63A71" } },
    { "scope": ["invalid.illegal", "invalid.illegal.invalid-usage-of-preprocessor-directive.pawn", "invalid.illegal.stray-comment-end.pawn", "invalid.illegal.invalid-character.pawn", "invalid.illegal.unknown-escape.pawn"], "settings": { "foreground": "#FFFFFF", "background": "#D43D51" } }
  ]
}
